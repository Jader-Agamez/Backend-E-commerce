NODE_ENV=development
PORT=5000

# JWT — usa una cadena larga y aleatoria en producción
# Genera una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Email SMTP (usa https://ethereal.email para desarrollo)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_ethereal_user@ethereal.email
EMAIL_PASS=your_ethereal_password
EMAIL_FROM=noreply@yourdomain.com

FRONTEND_URL=http://localhost:3000
