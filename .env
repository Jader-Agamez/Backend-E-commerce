PORT=5000

# Use SQLite as default for development and MySQL for production
# Comment out DB_HOST to use SQLite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=ecommerce_db

# JWT - Use a strong random string in production (min 32 chars)
JWT_SECRET=dev_only_secret_not_for_production_use_32chars_min
JWT_EXPIRES_IN=7d

# Email configuration
EMAIL_SERVICE=ethereal
EMAIL_USER=example@example.com
EMAIL_PASS=example@example.com
EMAIL_FROM=no-reply@ecommerce.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

NODE_ENV=development